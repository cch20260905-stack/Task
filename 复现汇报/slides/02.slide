<Slide style={{ width: 1280, height: 720, background: '#F7F9FC', position: 'relative', overflow: 'hidden', fontFamily: '思源黑体, Microsoft YaHei, sans-serif' }}>
    {/* A 页眉：深蓝顶条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 22, left: 60 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 1 }}>汇报提纲</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 26, right: 60 }}>
        <Text style={{ fontSize: 16, color: '#B9CBE8' }}>LGMFormer 声呐鱼群计数论文复现</Text>
    </Box>

    {/* 左标题栏 */}
    <Box style={{ position: 'absolute', top: 120, left: 60, width: 300 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.3 }}>
            四个部分
        </Text>
        <Box style={{ height: 18 }} />
        <Box style={{ width: 70, height: 4, background: '#1E4FA8' }} />
        <Box style={{ height: 22 }} />
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.8 }}>
            从论文方法拆解，
            <br />
            到实现、实验，
            <br />
            再到差距的诚实归因。
        </Text>
        <Box style={{ height: 26 }} />
        <Box style={{ padding: 16, background: '#E8EFF8', borderRadius: 8 }}>
            <Text style={{ fontSize: 17, color: '#1E4FA8', lineHeight: 1.7 }}>
                共 13 页 ｜ 11 次
                <br />
                300 轮完整实验
            </Text>
        </Box>
    </Box>

    {/* 右侧编号列表 */}
    <Box style={{ position: 'absolute', top: 120, left: 410, width: 810, flexDirection: 'column', gap: 20 }}>
        {[
            { n: '01', t: '背景与目标', d: '论文要解决什么问题、提出哪些创新、我的任务边界与复现约束' },
            { n: '02', t: '实现与方法', d: '数据侧 Otsu 标签生成 + 四个核心模块按 Eq.1–17 逐条实现' },
            { n: '03', t: '实验与结果', d: '11 次 300 轮实验对照表 + 收敛曲线，核心方法 MAE 降低 18.1%' },
            { n: '04', t: '差距归因与计划', d: '距离论文 3.22 的三个缺口及原因；下一步的验证计划' },
        ].map((it) => (
            <Box key={it.n} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 22, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 8, padding: '18px 24px' }}>
                <Box style={{ width: 58, height: 58, background: '#0E3F8C', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman, serif' }}>{it.n}</Text>
                </Box>
                <Box style={{ flex: 1, paddingTop: 2 }}>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.35 }}>{it.t}</Text>
                    <Box style={{ height: 8 }} />
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6 }}>{it.d}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* C 页脚 */}
    <Box style={{ position: 'absolute', bottom: 24, left: 60 }}>
        <Text style={{ fontSize: 15, color: '#8B97A8' }}>论文复现 · 声呐鱼群计数</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold', fontFamily: 'Times New Roman, serif' }}>02 / 13</Text>
    </Box>
</Slide>
