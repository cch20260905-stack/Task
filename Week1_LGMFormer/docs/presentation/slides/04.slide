<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', overflow: 'hidden', fontFamily: '思源黑体, Microsoft YaHei, sans-serif' }}>
    {/* A 页眉 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 22, left: 60 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF', letterSpacing: 1 }}>论文方法概览</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 26, right: 60 }}>
        <Text style={{ fontSize: 16, color: '#B9CBE8' }}>LGMFormer 结构主线</Text>
    </Box>

    {/* 左侧架构 SVG（占左 55%） */}
    <Box style={{ position: 'absolute', top: 108, left: 60, width: 640, height: 520, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8 }}>
        <Box style={{ position: 'absolute', top: 18, left: 24 }}>
            <Text style={{ fontSize: 17, color: '#4A5568', fontWeight: 'bold' }}>图 2 结构复刻（按论文 Fig.2 重绘）</Text>
        </Box>

        {/* 输入 */}
        <Box style={{ position: 'absolute', top: 70, left: 30, width: 82, height: 150, background: '#0E3F8C', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold', textAlign: 'center', lineHeight: 1.5 }}>声呐
                <br />图像</Text>
        </Box>

        {/* 编码器 */}
        <Box style={{ position: 'absolute', top: 70, left: 132, width: 96, height: 150, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold', textAlign: 'center', lineHeight: 1.5 }}>ResNet18
                <br />编码器</Text>
        </Box>

        {/* 特征层堆叠 */}
        <Box style={{ position: 'absolute', top: 70, left: 248, width: 130 }}>
            {['C4 512×16×16', 'C3 256×32×32', 'C2 128×64×64', 'C1  64×128×128'].map((t, i) => (
                <Box key={t} style={{ height: 32, marginBottom: 7, background: '#E8EFF8', border: '1px solid #3D7BD9', borderRadius: 5, justifyContent: 'center', paddingLeft: 10 }}>
                    <Text style={{ fontSize: 13, color: '#0E3F8C', fontFamily: 'Times New Roman, serif' }}>{t}</Text>
                </Box>
            ))}
        </Box>

        {/* 解码器（LGFI + HLFG） */}
        <Box style={{ position: 'absolute', top: 70, left: 396, width: 120, height: 150, background: '#3D7BD9', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold', textAlign: 'center', lineHeight: 1.55 }}>Transformer
                <br />解码器
                <br />
                <span style={{ fontSize: 13 }}>(LGFI ×3)</span>
            </Text>
        </Box>

        {/* HLFG 引导 */}
        <Box style={{ position: 'absolute', top: 236, left: 248, width: 268, height: 44, background: '#0E3F8C', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>HLFG 高层特征引导融合（Eq.1–3）</Text>
        </Box>

        {/* 多任务头 */}
        <Box style={{ position: 'absolute', top: 300, left: 132, width: 168, height: 92, background: '#E8EFF8', border: '1px solid #1E4FA8', borderRadius: 6, padding: 12 }}>
            <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>分割头 SegBranch</Text>
            <Box style={{ height: 6 }} />
            <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.5 }}>3 类语义 + CE/Dice</Text>
        </Box>
        <Box style={{ position: 'absolute', top: 300, left: 320, width: 196, height: 92, background: '#E8EFF8', border: '1px solid #1E4FA8', borderRadius: 6, padding: 12 }}>
            <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>密度头 + SEDH</Text>
            <Box style={{ height: 6 }} />
            <Text style={{ fontSize: 12.5, color: '#4A5568', lineHeight: 1.5 }}>概率图精修密度（Eq.9–11）</Text>
        </Box>

        {/* 底部虚线：辅助监督 */}
        <Box style={{ position: 'absolute', top: 410, left: 132, width: 384, height: 1, borderTop: '2px dashed #8B97A8' }} />
        <Box style={{ position: 'absolute', top: 428, left: 132, width: 384 }}>
            <Text style={{ fontSize: 13.5, color: '#8B97A8', textAlign: 'center' }}>虚线 = 多任务辅助监督（MTL），非推理路径</Text>
        </Box>
    </Box>

    {/* 右侧文字 */}
    <Box style={{ position: 'absolute', top: 108, left: 730, width: 490 }}>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.35 }}>
            一条主线：<br />用分割辅助计数
        </Text>
        <Box style={{ height: 20 }} />
        <Box style={{ width: 80, height: 4, background: '#1E4FA8' }} />
        <Box style={{ height: 26 }} />

        {[
            { n: '1', t: '编码器 ResNet18', d: '提取 C1–C4 四级特征，兼顾定位与语义' },
            { n: '2', t: 'LGFI 局部-全局交互', d: '窗内注意力 + 十字卷积 + 多尺度空洞卷积（Eq.4–6）' },
            { n: '3', t: 'HLFG 引导融合', d: '高层特征生成通道注意力加权低层（Eq.1–3）' },
            { n: '4', t: 'MTL + SEDH', d: '分割概率增强鱼区、抑制噪声，精修密度图' },
        ].map((it) => (
            <Box key={it.n} style={{ flexDirection: 'row', gap: 16, marginBottom: 16 }}>
                <Box style={{ width: 36, height: 36, background: '#1E4FA8', borderRadius: 18, justifyContent: 'center', alignItems: 'center', flexShrink: 0 }}>
                    <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold' }}>{it.n}</Text>
                </Box>
                <Box style={{ flex: 1, paddingTop: 2 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.35 }}>{it.t}</Text>
                    <Box style={{ height: 6 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5 }}>{it.d}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    {/* C 页脚 */}
    <Box style={{ position: 'absolute', bottom: 24, left: 60 }}>
        <Text style={{ fontSize: 15, color: '#8B97A8' }}>论文复现 · 声呐鱼群计数</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold', fontFamily: 'Times New Roman, serif' }}>04 / 13</Text>
    </Box>
</Slide>
